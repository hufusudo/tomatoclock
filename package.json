{
  "name": "tomatoclock",
  "version": "0.3.1",
  "private": true,
  "description": "Local study timer and daily learning records",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:web && npm run test:desktop",
    "test:web": "node --test --test-isolation=none tests/*.test.js",
    "test:desktop": "ELECTRON_RUN_AS_NODE=1 electron --test --test-isolation=none tests/desktop-*.test.cjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3 -v 44.6.0",
    "package:linux": "node scripts/package-linux.cjs",
    "release:local": "npm run package:linux && npm test && node scripts/publish-local.cjs",
    "cleanup:preview": "node scripts/cleanup.cjs",
    "cleanup": "node scripts/cleanup.cjs --apply",
    "verify:update": "ELECTRON_RUN_AS_NODE=1 electron tests/desktop-update-ui.cjs",
    "verify:ui": "node tests/desktop-ui.cjs"
  },
  "dependencies": { "better-sqlite3": "13.0.3" },
  "devDependencies": {
    "electron": "44.6.0",
    "@electron/rebuild": "4.2.1",
    "playwright-core": "1.63.0"
  }
}
